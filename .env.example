# --- RunPod deploy (used by deploy_runpod.py) ---
RUNPOD_API_KEY=
HF_TOKEN=

# --- Discord bot (used by bot.py) ---
DISCORD_TOKEN=
# Optional: comma-separated Discord user IDs allowed to chat.
# Leave EMPTY to run in OPEN mode (anyone in a server the bot is in can chat).
# Set to lock the bot to a specific set of users.
ALLOWED_USER_IDS=
# Optional. Comma-separated channel IDs the bot will respond in.
# Leave empty to allow all channels in servers the bot is in.
# Bot always responds to DMs from allowed users, and to @mentions.
ALLOWED_CHANNEL_IDS=

# Endpoint for the llama-server pod (filled in after `deploy_runpod.py launch`):
LLAMA_SERVER_URL=https://REPLACE_ME-8000.proxy.runpod.net/v1
MODEL_NAME=hauhau-aggressive

SYSTEM_PROMPT=You are a helpful assistant.
DB_PATH=/var/lib/hauhau-bot/history.db
HISTORY_LIMIT=30
MAX_TOKENS=2048
