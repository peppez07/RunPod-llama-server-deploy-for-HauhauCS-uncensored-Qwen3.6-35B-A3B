# Copy to .env. Never commit real credentials.
# Hugging Face READ token: https://huggingface.co/settings/tokens
HF_TOKEN=
# Required for RunPod launch; optional for localhost-only Compose.
# Choose your own long random password for your inference API.
LLAMA_API_KEY=
RUNPOD_API_KEY=

HF_REPO=OS-Software/Ternary-Bonsai-2-27B-Uncensored-Heretic-GGUF
HF_REVISION=5ab50fd49410941a8d4f97912303b1c7d458ffa2
GGUF_FILE=Ternary-Bonsai-2-27B-Uncensored-Heretic-PQ2_0.gguf
MODEL_ALIAS=bonsai-heretic
CTX_SIZE=32768
PARALLEL=1
N_GPU_LAYERS=99
REASONING_EFFORT=medium

# Publish the image using GitHub Actions before launching a pod.
LLAMA_SERVER_IMAGE=ghcr.io/peppez07/bonsai-llama-server-cuda:latest
GPU_TYPE_IDS=NVIDIA RTX A6000,NVIDIA L40S,NVIDIA RTX 6000 Ada Generation
VOLUME_GB=30
CONTAINER_DISK_GB=150
# Optional: cache survives pod deletion when using a RunPod network volume.
# NETWORK_VOLUME_ID=
# Optional: RunPod registry credential ID if the GHCR image is private.
# CONTAINER_REGISTRY_AUTH_ID=

# RunPod Serverless only: choose Load balancer and set these in RunPod.
# RUNPOD_SERVERLESS=1
# PORT=8000
# PORT_HEALTH=8001
# With a Serverless network volume:
# HF_HUB_CACHE=/runpod-volume/hf-cache
# Leave LLAMA_API_KEY unset for Serverless; use RunPod gateway authentication.

