[Unit]
Description=Hauhau Discord bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bobby
WorkingDirectory=/home/bobby/uncensored
EnvironmentFile=/home/bobby/uncensored/.env
ExecStart=/home/bobby/uncensored/.venv/bin/python /home/bobby/uncensored/bot.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

# DB lives outside the repo so deploys/git pulls don't touch it.
StateDirectory=hauhau-bot

[Install]
WantedBy=multi-user.target
