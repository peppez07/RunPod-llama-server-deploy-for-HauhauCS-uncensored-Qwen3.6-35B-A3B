# syntax=docker/dockerfile:1.7
# Use Prism's official CUDA binaries. RunPod's GitHub builder has a 30-minute
# limit, so compiling hundreds of CUDA objects there is not viable.
# Optional compilation path: Dockerfile.source (build outside RunPod).
FROM nvidia/cuda:12.8.1-runtime-ubuntu24.04
ARG PRISM_RELEASE=prism-b10826-c9c34bc
ARG PRISM_SHA256=e4345c9fed6452701fd511f9837726f39a45bc95fe103b8cae55360562eadf7f
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-venv ca-certificates curl libgomp1 libssl3t64 \
    && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir huggingface_hub==1.0.1 runpod==1.12.0
ENV PATH="/opt/venv/bin:${PATH}" \
    HF_HUB_CACHE=/workspace/hf-cache \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYTHONUNBUFFERED=1
# Keep every versioned library/backend from the SAME official Prism release.
RUN curl --fail --location --retry 3 \
      "https://github.com/PrismML-Eng/llama.cpp/releases/download/${PRISM_RELEASE}/llama-${PRISM_RELEASE}-bin-linux-cuda-12.8-x64.tar.gz" \
      --output /tmp/prism.tar.gz \
    && echo "${PRISM_SHA256}  /tmp/prism.tar.gz" | sha256sum --check --strict \
    && mkdir -p /opt/llama/bin \
    && tar -xzf /tmp/prism.tar.gz --strip-components=1 -C /opt/llama/bin \
    && rm /tmp/prism.tar.gz \
    && test -x /opt/llama/bin/llama-server
RUN ln -s /opt/llama/bin/llama-server /usr/local/bin/llama-server \
    && echo /opt/llama/bin > /etc/ld.so.conf.d/llama.conf && ldconfig \
    && /usr/local/bin/llama-server --version
# Explicit runtime defaults. Keep HF_TOKEN empty; supply it in RunPod.
# Console environment rows/storage allocation are configured on the endpoint.
ENV HF_TOKEN="" \
    RUNPOD_SERVERLESS=0 \
    PORT=8000 \
    PORT_HEALTH=8001 \
    HF_REPO=OS-Software/Ternary-Bonsai-2-27B-Uncensored-Heretic-GGUF \
    HF_REVISION=5ab50fd49410941a8d4f97912303b1c7d458ffa2 \
    GGUF_FILE=Ternary-Bonsai-2-27B-Uncensored-Heretic-PQ2_0.gguf \
    MODEL_ALIAS=bonsai-heretic \
    CTX_SIZE=32768 \
    PARALLEL=1 \
    N_GPU_LAYERS=99 \
    REASONING_EFFORT=medium
ENV RUNPOD_ENDPOINT_TYPE=auto
WORKDIR /app
COPY serve_model.py runpod_health.py queue_handler.py /app/
EXPOSE 8000 8001
HEALTHCHECK --interval=30s --timeout=10s --start-period=30m --retries=3 \
    CMD curl --fail --silent http://127.0.0.1:8000/health || exit 1
# No ENTRYPOINT: compatible with RunPod dockerStartCmd.
CMD ["python3", "/app/serve_model.py"]

