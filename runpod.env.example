# Runtime variables matching the verified RunPod Queue endpoint.
# For an HTTP Load Balancer endpoint, change this value to LOAD_BALANCER.
# auto detects RunPod's injected job-take webhook when using a generic image.
RUNPOD_ENDPOINT_TYPE=QUEUE
# In the console, set temporary storage / container disk to 150 GB separately.
# Paste your Hugging Face read token only into the RunPod HF_TOKEN value.
HF_TOKEN=
RUNPOD_SERVERLESS=1
PORT=8000
PORT_HEALTH=8001
HF_REPO=OS-Software/Ternary-Bonsai-2-27B-Uncensored-Heretic-GGUF
HF_REVISION=5ab50fd49410941a8d4f97912303b1c7d458ffa2
GGUF_FILE=Ternary-Bonsai-2-27B-Uncensored-Heretic-PQ2_0.gguf
MODEL_ALIAS=bonsai-heretic
CTX_SIZE=32768
PARALLEL=1
N_GPU_LAYERS=99
REASONING_EFFORT=medium
HF_HUB_CACHE=/workspace/hf-cache
# For an attached network volume instead:
# HF_HUB_CACHE=/runpod-volume/hf-cache
# Leave LLAMA_API_KEY unset: RunPod authenticates at the Serverless gateway.
